PROJECT_NAME="AI Smart Hospital Management System"
API_V1_STR="/api/v1"
ENV=development

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=hospital_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local zero-config default:
DATABASE_URL=sqlite:///./hospital.db

# Render PostgreSQL will provide a production DATABASE_URL.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Security Settings
# Generate a real one using: openssl rand -hex 32
SECRET_KEY=yoursecretkeyhereplaceholder
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Comma-separated origins for known deployed frontends.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3000

# Allows Vercel production and preview deployments to call the API.
BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
