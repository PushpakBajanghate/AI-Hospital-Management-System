# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=hospital_db
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Backend Configuration
BACKEND_PORT=8000
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/hospital_db
SECRET_KEY=replace-with-secure-random-secret
BACKEND_CORS_ORIGINS=https://your-vercel-app.vercel.app
BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
DEFAULT_ADMIN_EMAIL=admin@medos.com
DEFAULT_ADMIN_PASSWORD=change-this-before-production
DEFAULT_ADMIN_NAME=MedOS Administrator

# Frontend Configuration
VITE_API_URL=https://your-render-service.onrender.com
PORT=5173
